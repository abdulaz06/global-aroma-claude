---
/**
 * Concept mark: three eccentric contours around a release point, the
 * signature system at its smallest. Pending approval; the official logo is
 * not reproduced here because a clean source file was not available.
 */
interface Props { size?: number; class?: string; color?: string }
const { size = 32, class: cls, color = 'currentColor' } = Astro.props;
---
<svg class={cls} width={size} height={size} viewBox="0 0 40 40" fill="none" aria-hidden="true">
  <path d="M20.6 3.4c9.3.2 16.2 7.1 16 16.6-.2 9.4-7.6 16.6-17 16.4C10.4 36.2 3.4 29.3 3.5 20.2 3.7 10.8 11.3 3.2 20.6 3.4Z" stroke={color} stroke-width="1.4"/>
  <path d="M19.3 9.6c6.4.1 11 4.9 10.8 11.1-.1 6.1-5 10.7-11.2 10.6-6-.2-10.4-4.8-10.3-10.6.1-6.3 4.8-11.2 10.7-11.1Z" stroke={color} stroke-width="1.4"/>
  <path d="M17.9 15.4c3 .1 5.2 2.4 5.1 5.3 0 2.9-2.4 5-5.3 5-2.8-.1-4.9-2.3-4.8-5.1 0-2.9 2.2-5.3 5-5.2Z" stroke={color} stroke-width="1.4"/>
  <circle cx="16.6" cy="20.6" r="1.6" fill={color}/>
</svg>
