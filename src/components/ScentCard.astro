---
import type { Scent } from '../lib/library';
import { ACCORD_LABEL, PIGMENT } from '../lib/accords';
import AddButton from './AddButton.astro';
import { formatAED } from '../data/diffusers';
interface Props { s: Scent }
const { s } = Astro.props;
const text = [s.title, s.family, ...s.top, ...s.heart, ...s.base, ...s.mood].join(' ').toLowerCase();
---
<li class="scard" id={`scent-${s.slug}`} data-card data-accords={s.dominant.join(' ')} data-online={String(!!s.store)} data-text={text}>
  <a href={`#scent-${s.slug}`} class="scard-sig" data-open-scent={s.slug} tabindex="-1" aria-hidden="true">
    <img src={`/sig/${s.slug}.svg`} alt="" width="400" height="400" loading="lazy" decoding="async" />
  </a>
  <div class="scard-body">
    <p class="scard-fam label label-muted">{s.family}</p>
    <h3 class="scard-name"><a href={`#scent-${s.slug}`} data-open-scent={s.slug}>{s.title}</a></h3>
    <p class="scard-notes">{s.top.slice(0, 3).join(', ')}{s.heart.length ? ' · ' + s.heart.slice(0, 2).join(', ') : ''}</p>
    <p class="scard-acc">{s.dominant.map((a) => <span><i class="dot" style={`background:${PIGMENT[a]}`} />{ACCORD_LABEL[a]}</span>)}</p>
    <div class="scard-acts">
      <AddButton kind="scent" id={s.slug} label={s.title} meta={s.family} division="aroma" url={s.store?.url} text="Add" />
      {s.store && <a class="act act-buy" href={s.store.url} rel="noopener">Buy · <span class="num">{formatAED(s.store.price)}</span></a>}
    </div>
  </div>
</li>

<style>
  .scard { display: grid; gap: 0.9rem; align-content: start; padding-bottom: 1.25rem; border-bottom: var(--line); }
  .scard[hidden] { display: none; }
  .scard-sig { display: block; background: var(--paper-2); aspect-ratio: 1; padding: 9%; transition: background 0.3s; }
  .scard-sig:hover { background: var(--paper-3); }
  .scard-sig img { width: 100%; height: 100%; transition: transform 0.9s var(--ease); }
  .scard:hover .scard-sig img { transform: rotate(-6deg) scale(1.03); }
  @media (prefers-reduced-motion: reduce) { .scard:hover .scard-sig img { transform: none; } }
  .scard-body { display: grid; gap: 0.35rem; }
  .scard-name { font-family: var(--f-serif); font-size: 1.35rem; letter-spacing: -0.012em; line-height: 1.15; }
  .scard-name a { text-decoration: none; }
  .scard-name a:hover { text-decoration: underline; text-decoration-thickness: 1px; }
  .scard-notes { font-size: 0.86rem; color: var(--ink-72); line-height: 1.45; }
  .scard-acc { display: flex; flex-wrap: wrap; gap: 0.2rem 0.75rem; font-size: 0.75rem; color: var(--ink-56); }
  .scard-acc span { display: inline-flex; align-items: center; gap: 0.3rem; }
  .scard-acc .dot { width: 0.45rem; height: 0.45rem; }
  .scard-acts { display: flex; flex-wrap: wrap; gap: 0.25rem 1.1rem; margin-top: 0.2rem; }
</style>
