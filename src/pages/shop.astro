---
import { safeJson } from '../lib/safe-json';
/**
 * Shop: the merchant's whole public catalogue (synced from the WooCommerce
 * Store API), with purchase hand-off to the existing store. This page never
 * takes payment or creates orders. See docs/07 and docs/11.
 */
import Base from '../layouts/Base.astro';
import ProductCard from '../components/ProductCard.astro';
import AddButton from '../components/AddButton.astro';
import { shopProducts, catalog, clientProducts } from '../lib/catalog';
import { ACCORDS, ACCORD_LABEL, PIGMENT } from '../lib/accords';
import { company } from '../data/company';

const counts = { all: shopProducts.length, oils: shopProducts.filter((p) => p.category === 'oils').length, diffusers: shopProducts.filter((p) => p.category === 'diffusers').length };
const buyable = shopProducts.filter((p) => p.purchasable).length;
const accords = ACCORDS.filter((a) => shopProducts.some((p) => p.scent?.dominant.includes(a)));
// Default order: priced items first, oils with notes first, then by name.
const ordered = [...shopProducts].sort((a, b) =>
  (+b.purchasable - +a.purchasable) || (a.category === b.category ? 0 : a.category === 'oils' ? -1 : 1) || (+!!b.scent - +!!a.scent) || a.title.localeCompare(b.title));
const readAt = new Date(catalog.meta.readAt);
const readLabel = readAt.toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric', timeZone: 'Asia/Dubai' });
---
<Base title="Shop oils and diffusers" description={`The Global Aroma catalogue: ${counts.oils} diffuser oils and ${counts.diffusers} diffusers, with prices from the official store and checkout on globalaroma.me.`} current="shop" og="aroma">
  <section class="s-head">
    <div class="wrap s-head-in">
      <div>
        <p class="label kicker" style="color:var(--aroma-text)">Shop</p>
        <h1 class="hero-t">Order online.</h1>
      </div>
      <div class="s-head-side">
        <p class="lead">The full Global Aroma catalogue in one place. Choose here; your cart, payment and delivery are handled by the Global Aroma store.</p>
        <p class="s-fresh" data-fresh data-read-at={catalog.meta.readAt}>
          <span class="s-fresh-dot" aria-hidden="true"></span>
          <span data-fresh-text>Products and prices as listed on the Global Aroma store on {readLabel}.</span>
          <span class="muted">The store confirms the current price, stock and volume options before you pay.</span>
        </p>
      </div>
    </div>
  </section>

  <div class="s-bar" data-shop-bar>
    <div class="wrap s-bar-in">
      <div class="s-cats" role="group" aria-label="Category">
        <button type="button" class="seg" data-cat-btn="all" aria-pressed="true">All <span class="num">{counts.all}</span></button>
        <button type="button" class="seg" data-cat-btn="oils" aria-pressed="false">Oils <span class="num">{counts.oils}</span></button>
        <button type="button" class="seg" data-cat-btn="diffusers" aria-pressed="false">Diffusers <span class="num">{counts.diffusers}</span></button>
      </div>
      <label class="s-search"><span class="vh">Search products, notes or model codes</span><input class="input" type="search" placeholder="Search: oud, jasmine, OV-8…" data-q autocomplete="off" /></label>
      <label class="s-sort"><span class="vh">Sort</span>
        <select class="input" data-sort>
          <option value="featured">Featured</option>
          <option value="price-asc">Price: low to high</option>
          <option value="price-desc">Price: high to low</option>
          <option value="name">Name A–Z</option>
        </select>
      </label>
      <button type="button" class="btn btn-sm btn-line s-filter-btn" data-filter-toggle aria-expanded="false" aria-controls="shop-filters">Filters <span class="num" data-filter-count></span></button>
      <a class="act act-buy s-cart" href={company.store.cart} rel="noopener">Store cart</a>
    </div>
    <div class="wrap s-filters" id="shop-filters" data-filters hidden>
      <div class="s-fgroup" role="group" aria-label="Character (oils with published notes)">
        <span class="label label-muted">Character</span>
        {accords.map((a) => <button type="button" class="chip" data-accord={a} aria-pressed="false"><span class="dot" style={`background:${PIGMENT[a]}`} />{ACCORD_LABEL[a]}</button>)}
      </div>
      <div class="s-fgroup">
        <label class="s-check"><input type="checkbox" data-only-buyable /> Available to buy online</label>
        <label class="s-check"><input type="checkbox" data-only-notes /> With published notes</label>
        <button type="button" class="act" data-clear>Clear all</button>
      </div>
    </div>
  </div>

  <section class="wrap s-results" aria-labelledby="results-h">
    <h2 class="vh" id="results-h">Products</h2>
    <p class="s-count label label-muted" data-count aria-live="polite">{counts.all} products · {buyable} available online</p>
    <ul class="s-grid" data-grid>
      {ordered.map((p, i) => <ProductCard p={p} eager={i < 4} />)}
    </ul>
    <div class="s-empty" data-empty hidden>
      <p class="h3">Nothing matches.</p>
      <p class="muted">Try another search, or <button type="button" class="link" data-clear>clear the filters</button>. Looking for something we don’t list? <a href="/brief">Ask us</a>.</p>
    </div>
    <p class="s-more" data-more-wrap hidden><button type="button" class="btn btn-line" data-more>Show more <span class="num" data-more-n></span></button></p>
  </section>

  <section class="section tint s-quote" aria-labelledby="quote-h">
    <div class="wrap s-quote-in">
      <div>
        <p class="label label-muted kicker">On request</p>
        <h2 class="h2" id="quote-h">Volumes, samplers and projects.</h2>
        <p class="body-copy">For several sites, a whole building or a signature scent, add what you need to a brief and the team will quote.</p>
      </div>
      <ul class="rows s-quote-list">
        <li><span>Scent box: 21 fragrances, 5 ml each</span><AddButton kind="category" id="scent-box" label="Scent box (21 × 5 ml)" division="aroma" /></li>
        <li><span>Signature scent for a brand</span><AddButton kind="category" id="aroma-custom" label="Signature scent" division="aroma" /></li>
        <li><span>Candles, reed diffusers &amp; room spray</span><AddButton kind="category" id="candles" label="Candles, reed diffusers & room spray" division="aroma" /></li>
        <li><span>Commercial volumes of any oil</span><AddButton kind="category" id="oil-volumes" label="Commercial oil volumes" division="aroma" /></li>
      </ul>
    </div>
  </section>

  <dialog class="pd" data-product-dialog aria-labelledby="pd-title">
    <div class="pd-in">
      <button class="pd-x btn btn-sm btn-line" type="button" data-close>Close</button>
      <div class="pd-media" data-pd-media></div>
      <div class="pd-body">
        <p class="label label-muted" data-pd-kind></p>
        <h2 class="h1 pd-title" id="pd-title" data-pd-title></h2>
        <p class="pd-price"><span class="num" data-pd-price></span> <span class="muted" data-pd-opt></span> <span class="pd-stock" data-pd-stock></span></p>
        <p class="muted pd-sum" data-pd-sum></p>
        <dl class="pd-notes" data-pd-notes></dl>
        <p class="pd-note" data-pd-notes-src></p>
        <div class="pd-vols" data-pd-vols></div>
        <div class="pd-acts">
          <a class="btn" data-pd-cart rel="noopener" href={company.store.shop}>Add to cart on globalaroma.me <span class="ext" aria-hidden="true">↗</span></a>
          <a class="btn btn-line" data-pd-view rel="noopener" href={company.store.shop}>View on the store <span class="ext" aria-hidden="true">↗</span></a>
          <button class="act act-add" type="button" data-pd-brief>Add to brief</button>
        </div>
        <p class="pd-fine muted">Checkout, payment and delivery happen on the Global Aroma store, which confirms the final price and stock. <span data-pd-sku></span></p>
      </div>
    </div>
  </dialog>

  <script type="application/json" id="product-data" set:html={safeJson({ meta: catalog.meta, products: clientProducts() })} />
</Base>

<script>
  import '../scripts/shop';
</script>

<style>
  .s-head { padding-block: clamp(2rem, 5vw, 4rem) clamp(1.5rem, 3vw, 2.5rem); }
  .s-head-in { display: grid; grid-template-columns: 1fr minmax(0, 30rem); gap: 1.5rem 2rem; align-items: end; }
  .s-head-in > div:first-child { display: grid; gap: 1rem; }
  .s-head-side { display: grid; gap: 1rem; }
  .s-fresh { font-size: 0.85rem; display: grid; grid-template-columns: auto 1fr; gap: 0.15rem 0.6rem; align-items: baseline; color: var(--ink-72); }
  .s-fresh .muted { grid-column: 2; font-size: 0.8rem; }
  .s-fresh-dot { width: 0.5rem; height: 0.5rem; border-radius: 50%; background: var(--ink-32); align-self: center; }
  @media (max-width: 860px) { .s-head-in { grid-template-columns: 1fr; } }

  .s-bar { position: sticky; top: var(--nav-h); z-index: 40; background: color-mix(in srgb, var(--paper) 94%, transparent); backdrop-filter: blur(10px); -webkit-backdrop-filter: blur(10px); border-block: var(--line); }
  .s-bar-in { display: flex; align-items: center; gap: 0.75rem; padding-block: 0.65rem; flex-wrap: wrap; }
  .s-cats { display: inline-flex; border: 1px solid var(--ink-32); border-radius: 99px; padding: 0.15rem; }
  .seg { border: 0; background: none; border-radius: 99px; padding: 0.45rem 0.9rem; min-height: 2.5rem; cursor: pointer; font-size: 0.9rem; display: inline-flex; gap: 0.4rem; align-items: baseline; }
  .seg .num { font-size: 0.72rem; color: var(--ink-56); }
  .seg[aria-pressed='true'] { background: var(--ink); color: var(--paper); }
  .seg[aria-pressed='true'] .num { color: var(--p-72); }
  .s-search { flex: 1 1 14rem; }
  .s-search .input, .s-sort .input { min-height: 2.75rem; padding-block: 0.5rem; }
  .s-sort { flex: 0 0 12.5rem; }
  .s-cart { margin-left: auto; white-space: nowrap; }
  .s-filters { display: grid; gap: 0.75rem; padding-block: 0.25rem 1rem; }
  .s-filters[hidden] { display: none; }
  .s-fgroup { display: flex; flex-wrap: wrap; align-items: center; gap: 0.5rem 0.6rem; }
  .s-check { display: inline-flex; gap: 0.45rem; align-items: center; font-size: 0.9rem; min-height: 2.5rem; cursor: pointer; }
  .s-check input { width: 1.15rem; height: 1.15rem; accent-color: var(--ink); }
  @media (max-width: 760px) {
    .s-bar-in { gap: 0.5rem; }
    .s-cats { order: 1; flex: 1 1 100%; justify-content: space-between; }
    .seg { flex: 1; justify-content: center; padding-inline: 0.5rem; }
    .s-search { order: 2; flex: 1 1 100%; }
    .s-sort { order: 3; flex: 1 1 0; }
    .s-filter-btn { order: 4; min-height: 2.75rem; }
    .s-cart { order: 5; margin-left: 0; }
    .s-fgroup:first-child { flex-wrap: nowrap; overflow-x: auto; scrollbar-width: none; margin-inline: calc(var(--gutter) * -1); padding-inline: var(--gutter); }
  }

  .s-results { padding-block: 1.25rem var(--section); }
  .s-count { margin-bottom: 1rem; }
  .s-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(14.5rem, 1fr)); border-top: var(--line); border-left: var(--line); }
  @media (max-width: 560px) { .s-grid { grid-template-columns: 1fr 1fr; } }
  .s-empty { padding: 3rem 0; display: grid; gap: 0.5rem; }
  .s-empty[hidden] { display: none; }
  .s-more { display: flex; justify-content: center; margin-top: 2rem; }
  .s-more[hidden] { display: none; }

  .s-quote-in { display: grid; grid-template-columns: repeat(12, minmax(0, 1fr)); column-gap: 2rem; row-gap: 1.5rem; align-items: start; }
  .s-quote-in > div { grid-column: 1 / span 5; display: grid; gap: 1rem; }
  .s-quote-list { grid-column: 7 / -1; }
  .rows { width: 100%; border-top: var(--line); }
  .rows li { display: flex; justify-content: space-between; align-items: center; gap: 1rem; padding: 0.7rem 0; border-bottom: var(--line); }
  @media (max-width: 860px) { .s-quote-in > div, .s-quote-list { grid-column: 1 / -1; } }

  .pd { width: min(66rem, calc(100vw - 2rem)); max-height: calc(100dvh - 2rem); padding: 0; border: 0; background: var(--paper); color: var(--ink); box-shadow: 0 30px 80px rgba(26,23,20,0.28); }
  .pd::backdrop { background: rgba(26, 23, 20, 0.45); backdrop-filter: blur(3px); }
  .pd-in { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.15fr); position: relative; }
  .pd-x { position: absolute; top: 1rem; right: 1rem; z-index: 2; background: var(--paper); }
  .pd-media { background: var(--paper-2); padding: clamp(1.25rem, 3vw, 2.5rem); display: grid; gap: 1rem; align-content: center; }
  .pd-body { padding: clamp(1.25rem, 3vw, 2.5rem); padding-top: 3.5rem; display: grid; gap: 0.9rem; align-content: start; }
  .pd-title { font-size: clamp(2rem, 3.4vw, 3rem); }
  .pd-price { font-size: 1.1rem; display: flex; flex-wrap: wrap; gap: 0.3rem 0.7rem; align-items: baseline; }
  .pd-stock { font-size: 0.85rem; color: var(--hospitality-text); }
  .pd-notes { margin: 0; border-top: var(--line); }
  .pd-notes:empty { display: none; }
  .pd-note { font-size: 0.82rem; color: var(--ink-72); }
  .pd-note:empty { display: none; }
  .pd-acts { display: flex; flex-wrap: wrap; gap: 0.6rem 1rem; align-items: center; margin-top: 0.25rem; }
  .pd-fine { font-size: 0.8rem; }
  @media (max-width: 760px) {
    .pd { width: 100vw; max-width: 100vw; height: 100dvh; max-height: 100dvh; margin: 0; }
    .pd-in { grid-template-columns: 1fr; }
    .pd-media { padding: 3.5rem 1.25rem 1rem; grid-template-columns: 1fr 1fr; }
    .pd-acts .btn { width: 100%; }
  }
</style>

<style is:global>
  .pd-fig { margin: 0; display: grid; gap: 0.4rem; }
  .pd-fig img { width: 100%; aspect-ratio: 1; object-fit: contain; background: var(--paper); }
  .pd-fig figcaption { font-family: var(--f-mono); font-size: 0.66rem; letter-spacing: 0.06em; text-transform: uppercase; color: var(--ink-56); }
  .pd-notes div { display: grid; grid-template-columns: 4.5rem 1fr; gap: 1rem; padding: 0.6rem 0; border-bottom: var(--line); font-size: 0.95rem; }
  .pd-notes dt { font-family: var(--f-mono); font-size: 0.7rem; letter-spacing: 0.08em; text-transform: uppercase; color: var(--ink-56); padding-top: 0.2rem; }
  .pd-notes dd { margin: 0; }
  .pd-vols { display: flex; flex-wrap: wrap; gap: 0.4rem; }
  .pd-vol { font-size: 0.8rem; padding: 0.25rem 0.6rem; border: 1px solid var(--ink-32); border-radius: 99px; }
  .pd-vol-note { width: 100%; font-size: 0.8rem; color: var(--ink-72); margin-top: 0.2rem; }
  .pd-flag { font-size: 0.82rem; background: color-mix(in srgb, #b8862b 12%, transparent); border-left: 3px solid #b8862b; padding: 0.5rem 0.75rem; }
</style>
