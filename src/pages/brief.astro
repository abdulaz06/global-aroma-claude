---
import Base from '../layouts/Base.astro';
import { company, industries } from '../data/company';
---
<Base title="Build a brief" description="Shortlist fragrances, diffusers, hospitality supplies and technology, describe your space, and send the brief to Global DWC LLC by email or WhatsApp." current="brief">
  <section class="b-head">
    <div class="wrap">
      <p class="label kicker">Enquiry</p>
      <h1 class="hero-t">Your brief.</h1>
      <p class="lead">Describe the space, review your shortlist and send it to the Dubai team. It takes about two minutes.</p>
    </div>
  </section>

  <noscript>
    <div class="wrap noscript">
      <p>The brief builder needs JavaScript. You can reach the team directly: <a href={`mailto:${company.email.general}`}>{company.email.general}</a>, <a href={company.phone.href}>{company.phone.display}</a>, or WhatsApp <a href={`https://wa.me/${company.whatsapp.number}`}>{company.whatsapp.display}</a>.</p>
    </div>
  </noscript>

  <div class="wrap b-grid" data-brief-app>
    <form class="b-form" novalidate data-form>
      <fieldset class="b-step">
        <legend><span class="num">01</span><span class="h2">The space</span></legend>
        <div class="b-q">
          <p class="b-qt" id="need-l">What do you need?</p>
          <div class="b-needs" role="group" aria-labelledby="need-l">
            <label class="need" style="--c:var(--aroma)"><input type="checkbox" name="need" value="aroma" /><span><b>Scent</b><small>Fragrance, diffusers, home fragrance</small></span></label>
            <label class="need" style="--c:var(--aroma)"><input type="checkbox" name="need" value="signature" /><span><b>Signature scent</b><small>A bespoke fragrance for a brand</small></span></label>
            <label class="need" style="--c:var(--hospitality)"><input type="checkbox" name="need" value="hospitality" /><span><b>Hospitality supplies</b><small>Linen, amenities, trolleys, furniture</small></span></label>
            <label class="need" style="--c:var(--technology)"><input type="checkbox" name="need" value="technology" /><span><b>Technology</b><small>ICT, signage, integration, support</small></span></label>
          </div>
        </div>
        <div class="b-row">
          <label class="field"><span>Type of space</span>
            <select class="input" name="space">
              <option value="">Choose…</option>
              {industries.map((i) => <option>{i.name}</option>)}
              <option>Office</option><option>Retail store</option><option>Spa or gym</option><option>Home</option><option>Other</option>
            </select>
          </label>
          <label class="field"><span>Approximate size</span>
            <select class="input" name="size">
              <option value="">Choose…</option>
              <option>Under 100 m²</option><option>100–500 m²</option><option>500–2,000 m²</option><option>Over 2,000 m²</option><option>Not sure</option>
            </select>
          </label>
        </div>
        <div class="b-row">
          <label class="field"><span>Number of locations or zones</span><input class="input" type="number" name="zones" min="1" max="999" inputmode="numeric" placeholder="1" /></label>
          <label class="field"><span>Timing</span>
            <select class="input" name="timing">
              <option value="">Choose…</option>
              <option>As soon as possible</option><option>Within a month</option><option>In 1–3 months</option><option>Just exploring</option>
            </select>
          </label>
        </div>
        <div class="b-q" data-hvac hidden>
          <p class="b-qt" id="hvac-l">Does the space have central air conditioning (HVAC) we could connect to?</p>
          <div class="b-radios" role="radiogroup" aria-labelledby="hvac-l">
            <label class="chip-r"><input type="radio" name="hvac" value="Yes" /> Yes</label>
            <label class="chip-r"><input type="radio" name="hvac" value="No" /> No</label>
            <label class="chip-r"><input type="radio" name="hvac" value="Not sure" /> Not sure</label>
          </div>
        </div>
      </fieldset>

      <fieldset class="b-step">
        <legend><span class="num">02</span><span class="h2">Your shortlist</span></legend>
        <ul class="b-items" data-items aria-live="polite"></ul>
        <div class="b-empty" data-empty>
          <p class="muted">Nothing shortlisted yet. That’s fine: you can send the brief without a shortlist, or add some first.</p>
          <p class="b-empty-links"><a class="link" href="/aroma#library">Fragrances</a><a class="link" href="/aroma#diffusers">Diffusers</a><a class="link" href="/hospitality">Hospitality</a><a class="link" href="/technology">Technology</a></p>
        </div>
      </fieldset>

      <fieldset class="b-step">
        <legend><span class="num">03</span><span class="h2">Your details</span></legend>
        <div class="b-row">
          <label class="field"><span>Name <abbr title="required">*</abbr></span><input class="input" name="name" autocomplete="name" required /></label>
          <label class="field"><span>Company or property</span><input class="input" name="company" autocomplete="organization" /></label>
        </div>
        <div class="b-row">
          <label class="field"><span>Email</span><input class="input" type="email" name="email" autocomplete="email" /></label>
          <label class="field"><span>Phone</span><input class="input" type="tel" name="phone" autocomplete="tel" placeholder="+971" /></label>
        </div>
        <label class="field"><span>Anything else?</span><textarea class="input" name="message" rows="4" placeholder="The atmosphere you want, dates, quantities, questions…"></textarea></label>
        <p class="b-err" data-err role="alert" hidden></p>
      </fieldset>
    </form>

    <aside class="b-out" aria-labelledby="out-h">
      <div class="b-out-in">
        <h2 class="label" id="out-h">Brief preview</h2>
        <pre class="b-pre" data-preview tabindex="0" aria-label="Brief text preview"></pre>
        <div class="b-send">
          <a class="btn" href={`mailto:${company.email.general}`} data-send="email">Send by email</a>
          <a class="btn btn-line" href={`https://wa.me/${company.whatsapp.number}`} target="_blank" rel="noopener" data-send="whatsapp">Send on WhatsApp</a>
          <button class="act" type="button" data-copy>Copy text</button>
        </div>
        <p class="b-note muted">Sending opens your own email app or WhatsApp with this brief filled in, addressed to {company.email.general} or {company.whatsapp.display}. This website does not store or send anything itself.</p>
        <button class="act b-clear" type="button" data-clear>Clear shortlist</button>
      </div>
    </aside>
  </div>
</Base>

<script>
  import { brief, type BriefItem } from '../scripts/brief-store';
  import { showToast } from '../scripts/site';

  const EMAIL = 'info@globaldwc.com';
  const WA = '971555827212';
  const form = document.querySelector<HTMLFormElement>('[data-form]')!;
  const itemsEl = document.querySelector<HTMLUListElement>('[data-items]')!;
  const emptyEl = document.querySelector<HTMLElement>('[data-empty]')!;
  const pre = document.querySelector<HTMLElement>('[data-preview]')!;
  const err = document.querySelector<HTMLElement>('[data-err]')!;
  const hvac = document.querySelector<HTMLElement>('[data-hvac]')!;
  const NEED: Record<string, string> = { aroma: 'Scent', signature: 'Signature scent', hospitality: 'Hospitality supplies', technology: 'Technology' };
  const GROUP: Record<BriefItem['division'], string> = { aroma: 'Global Aroma', hospitality: 'Global Hospitality', technology: 'Global Technology' };

  // Pre-select needs from ?need= and from what is already shortlisted.
  const params = new URLSearchParams(location.search);
  const pre0 = new Set((params.get('need') || '').split(',').filter(Boolean));
  brief.items().forEach((i) => pre0.add(i.division));
  form.querySelectorAll<HTMLInputElement>('input[name=need]').forEach((c) => (c.checked = pre0.has(c.value)));

  function val(name: string) { return (form.elements.namedItem(name) as HTMLInputElement | null)?.value.trim() ?? ''; }
  function needs() { return [...form.querySelectorAll<HTMLInputElement>('input[name=need]:checked')].map((c) => c.value); }

  function renderItems() {
    const items = brief.items();
    itemsEl.innerHTML = '';
    emptyEl.hidden = items.length > 0;
    for (const it of items) {
      const li = document.createElement('li');
      li.className = 'b-item';
      li.style.setProperty('--c', `var(--${it.division})`);
      li.innerHTML = `<span class="b-item-d"></span><span class="b-item-l"><b></b><small></small></span><button type="button" class="act">Remove</button>`;
      li.querySelector('b')!.textContent = it.label;
      li.querySelector('small')!.textContent = [GROUP[it.division], it.meta].filter(Boolean).join(' · ');
      const btn = li.querySelector('button')!;
      btn.setAttribute('aria-label', `Remove ${it.label}`);
      btn.addEventListener('click', () => brief.remove(it.kind, it.id));
      itemsEl.appendChild(li);
    }
  }

  function text() {
    const n = needs();
    const items = brief.items();
    const L: string[] = ['Hello Global DWC team,', '', 'I would like a proposal for the following.', ''];
    const add = (k: string, v: string) => v && L.push(`${k}: ${v}`);
    add('Need', n.map((x) => NEED[x]).join(', '));
    add('Space', val('space'));
    add('Size', val('size'));
    add('Locations / zones', val('zones'));
    add('Timing', val('timing'));
    const hv = form.querySelector<HTMLInputElement>('input[name=hvac]:checked');
    if (!hvac.hidden && hv) add('Central HVAC', hv.value);
    if (items.length) {
      L.push('', 'Shortlist:');
      for (const d of ['aroma', 'hospitality', 'technology'] as const) {
        const group = items.filter((i) => i.division === d);
        if (!group.length) continue;
        L.push(`  ${GROUP[d]}`);
        group.forEach((i) => L.push(`  - ${i.label}${i.meta ? ` (${i.meta})` : ''}`));
      }
    }
    if (val('message')) L.push('', val('message'));
    L.push('', '—');
    add('Name', val('name'));
    add('Company', val('company'));
    add('Email', val('email'));
    add('Phone', val('phone'));
    return L.join('\n');
  }

  const sendEmail = document.querySelector<HTMLAnchorElement>('[data-send=email]')!;
  const sendWa = document.querySelector<HTMLAnchorElement>('[data-send=whatsapp]')!;
  function update() {
    hvac.hidden = !needs().includes('aroma');
    const body = text();
    pre.textContent = body;
    const subject = `Brief: ${needs().map((x) => NEED[x]).join(', ') || 'Enquiry'}${val('company') ? ' — ' + val('company') : ''}`;
    sendEmail.href = `mailto:${EMAIL}?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(body)}`;
    sendWa.href = `https://wa.me/${WA}?text=${encodeURIComponent(body)}`;
  }

  function check(): boolean {
    const problems: string[] = [];
    if (!val('name')) problems.push('your name');
    if (!val('email') && !val('phone')) problems.push('an email address or phone number');
    const email = form.elements.namedItem('email') as HTMLInputElement;
    if (val('email') && !email.checkValidity()) problems.push('a valid email address');
    if (problems.length) {
      err.textContent = `Please add ${problems.join(' and ')} so the team can reply.`;
      err.hidden = false;
      const first = !val('name') ? 'name' : 'email';
      (form.elements.namedItem(first) as HTMLElement).focus();
      return false;
    }
    err.hidden = true;
    return true;
  }

  // Links carry the full brief at all times; sending is only blocked until the team has a way to reply.
  [sendEmail, sendWa].forEach((a) => a.addEventListener('click', (e) => { update(); if (!check()) e.preventDefault(); }));
  document.querySelector('[data-copy]')!.addEventListener('click', async () => {
    try { await navigator.clipboard.writeText(text()); showToast('Brief copied'); }
    catch { const r = document.createRange(); r.selectNodeContents(pre); getSelection()?.removeAllRanges(); getSelection()?.addRange(r); showToast('Select and copy the highlighted text'); }
  });
  document.querySelector('[data-clear]')!.addEventListener('click', () => { if (brief.items().length) { brief.clear(); showToast('Shortlist cleared'); } });

  form.addEventListener('input', update);
  form.addEventListener('change', update);
  window.addEventListener('brief:change', () => { renderItems(); update(); });
  renderItems();
  update();
</script>

<style>
  .b-head { padding-block: clamp(2.5rem, 6vw, 5rem) clamp(2rem, 4vw, 3rem); }
  .b-head .wrap { display: grid; gap: 1.25rem; }
  .noscript { padding-bottom: 2rem; }
  .b-grid { display: grid; grid-template-columns: minmax(0, 7fr) minmax(0, 5fr); gap: clamp(2rem, 5vw, 5rem); padding-bottom: var(--section); align-items: start; }
  .b-form { display: grid; gap: clamp(2.5rem, 5vw, 4rem); }
  .b-step { border: 0; padding: 0; margin: 0; display: grid; gap: 1.5rem; min-width: 0; }
  .b-step legend { display: flex; align-items: baseline; gap: 1rem; padding: 0 0 1rem; border-bottom: var(--line-strong); width: 100%; margin-bottom: 1.5rem; }
  .b-step legend .num { font-size: 0.85rem; color: var(--ink-56); }
  .b-row { display: grid; grid-template-columns: 1fr 1fr; gap: 1.25rem; }
  @media (max-width: 640px) { .b-row { grid-template-columns: 1fr; } }
  .b-q { display: grid; gap: 0.75rem; }
  .b-q[hidden] { display: none; }
  .b-qt { font-size: 0.95rem; font-weight: 560; }
  .b-needs { display: grid; grid-template-columns: 1fr 1fr; gap: 0.6rem; }
  @media (max-width: 560px) { .b-needs { grid-template-columns: 1fr; } }
  .need { position: relative; display: block; cursor: pointer; }
  .need input { position: absolute; opacity: 0; inset: 0; cursor: pointer; }
  .need > span { display: grid; gap: 0.15rem; padding: 0.9rem 1rem 0.95rem 2.6rem; border: 1px solid var(--ink-32); border-radius: var(--radius); transition: border-color 0.2s, background 0.2s; position: relative; }
  .need > span::before { content: ''; position: absolute; left: 1rem; top: 1.15rem; width: 0.95rem; height: 0.95rem; border: 1px solid var(--ink-56); border-radius: 2px; }
  .need small { color: var(--ink-56); font-size: 0.8rem; }
  .need:hover > span { border-color: var(--ink); }
  .need input:checked + span { border-color: var(--c); background: color-mix(in srgb, var(--c) 7%, transparent); box-shadow: inset 3px 0 0 var(--c); }
  .need input:checked + span::before { background: var(--c); border-color: var(--c); }
  .need input:checked + span::after { content: ''; position: absolute; left: 1.28rem; top: 1.3rem; width: 0.35rem; height: 0.6rem; border: solid var(--paper); border-width: 0 2px 2px 0; transform: rotate(45deg); }
  .need input:focus-visible + span { outline: 2px solid var(--ink); outline-offset: 2px; }
  .b-radios { display: flex; flex-wrap: wrap; gap: 0.5rem; }
  .chip-r { display: inline-flex; align-items: center; gap: 0.45rem; min-height: 2.6rem; padding: 0.35rem 0.95rem; border: 1px solid var(--ink-32); border-radius: 99px; cursor: pointer; font-size: 0.92rem; }
  .chip-r:has(input:checked) { border-color: var(--ink); background: var(--ink); color: var(--paper); }
  .chip-r input { accent-color: var(--paper); }
  .b-items { border-top: var(--line); }
  .b-items:empty { display: none; }
  :global(.b-item) { display: grid; grid-template-columns: 0.6rem 1fr auto; gap: 1rem; align-items: center; padding: 0.8rem 0; border-bottom: var(--line); }
  :global(.b-item-d) { width: 0.55rem; height: 0.55rem; border-radius: 50%; background: var(--c); }
  :global(.b-item-l) { display: grid; }
  :global(.b-item-l small) { color: var(--ink-56); font-size: 0.8rem; }
  .b-empty { display: grid; gap: 1rem; padding: 1.25rem; border: 1px dashed var(--ink-32); }
  .b-empty[hidden] { display: none; }
  .b-empty-links { display: flex; flex-wrap: wrap; gap: 0.75rem 1.5rem; }
  abbr { text-decoration: none; color: var(--aroma); }
  .b-err { color: #9b2c1d; font-weight: 560; font-size: 0.92rem; }
  .b-out { position: sticky; top: calc(var(--nav-h) + 1.5rem); }
  .b-out-in { background: var(--ink); color: var(--paper); padding: clamp(1.25rem, 3vw, 2rem); display: grid; gap: 1.1rem; }
  .b-out-in .label { color: var(--p-56); }
  .b-pre { margin: 0; white-space: pre-wrap; word-break: break-word; font-family: var(--f-mono); font-size: 0.8rem; line-height: 1.6; color: var(--p-72); max-height: 42vh; overflow: auto; border-block: 1px solid var(--p-12); padding-block: 1rem; }
  .b-send { display: grid; grid-template-columns: 1fr 1fr; gap: 0.6rem; }
  .b-send .btn { --b: var(--paper); --f: var(--ink); }
  .b-send .btn-line { background: transparent; color: var(--paper); }
  .b-send .btn-line:hover { background: var(--paper); color: var(--ink); }
  .b-send .act { grid-column: 1 / -1; justify-self: start; color: var(--paper); }
  .b-note { font-size: 0.8rem; color: var(--p-56) !important; }
  .b-clear { color: var(--p-56); justify-self: start; font-size: 0.8rem; }
  @media (max-width: 960px) { .b-grid { grid-template-columns: 1fr; } .b-out { position: static; } }
  @media (max-width: 420px) { .b-send { grid-template-columns: 1fr; } }
</style>
