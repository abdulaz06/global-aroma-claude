---
import Base from '../layouts/Base.astro';
import Pattern from '../components/Pattern.astro';
import { company, waLink } from '../data/company';
---
<Base title="Contact" description="Contact Global DWC LLC in Dubai World Central: phone, WhatsApp, email and office address for Global Aroma, Global Hospitality and Global Technology." current="contact">
  <section class="c-head">
    <div class="wrap c-head-in">
      <div>
        <p class="label kicker">Contact</p>
        <h1 class="hero-t">Dubai World Central.</h1>
      </div>
      <p class="lead">One team for all three divisions. Call, message or write, or <a href="/brief">build a brief</a> so we have the details from the start.</p>
    </div>
  </section>

  <section class="wrap c-grid">
    <div class="c-block">
      <h2 class="label label-muted">Call</h2>
      <a class="c-big serif" href={company.phone.href}>{company.phone.display}</a>
      <p class="muted">Main line for enquiries</p>
    </div>
    <div class="c-block">
      <h2 class="label label-muted">WhatsApp</h2>
      <a class="c-big serif" href={waLink('Hello Global Aroma, ')} rel="noopener">{company.whatsapp.display}</a>
      <p class="muted">Messages and quick questions</p>
    </div>
    <div class="c-block">
      <h2 class="label label-muted">Email</h2>
      <a class="c-big serif" href={`mailto:${company.email.general}`}>{company.email.general}</a>
      <p class="muted">Business development: <a href={`mailto:${company.email.business}`}>{company.email.business}</a></p>
    </div>
    <div class="c-block c-office">
      <h2 class="label label-muted">Office</h2>
      <address class="c-addr serif">{company.address.lines.map((l) => <span>{l}</span>)}</address>
      <p class="muted">{company.legalName} · {company.address.poBox}</p>
      <a class="btn btn-line btn-sm" href={company.address.mapsUrl} rel="noopener">Get directions <span class="ext" aria-hidden="true">↗</span></a>
    </div>
    <div class="c-block">
      <h2 class="label label-muted">Other numbers</h2>
      <ul class="c-list">{company.otherMobiles.map((m) => <li><a href={m.href}>{m.display}</a></li>)}</ul>
    </div>
    <div class="c-block">
      <h2 class="label label-muted">Online store</h2>
      <a class="c-big serif" href={company.store.shop} rel="noopener">globalaroma.me ↗</a>
      <p class="muted">Oils and diffusers, with checkout</p>
    </div>
  </section>
  <div class="c-art" aria-hidden="true"><Pattern behaviour="flow" w={1600} h={360} lines={18} seed="contact" accent="#b4612a" /></div>
</Base>

<style>
  .c-head { padding-block: clamp(2.5rem, 6vw, 5rem) clamp(2.5rem, 5vw, 4rem); }
  .c-head-in { display: grid; grid-template-columns: 1fr minmax(0, 26rem); gap: 2rem; align-items: end; }
  .c-head-in > div { display: grid; gap: 1.25rem; }
  @media (max-width: 860px) { .c-head-in { grid-template-columns: 1fr; } }
  .c-grid { display: grid; grid-template-columns: repeat(3, 1fr); border-top: var(--line-strong); }
  .c-block { padding: 1.75rem 1.75rem 2.25rem 0; display: grid; gap: 0.6rem; align-content: start; justify-items: start; border-bottom: var(--line); }
  .c-block:not(:nth-child(3n + 1)) { padding-left: 1.75rem; border-left: var(--line); }
  .c-big { font-size: clamp(1.4rem, 2.2vw, 2rem); letter-spacing: -0.015em; text-decoration: none; line-height: 1.15; word-break: break-word; }
  .c-big:hover { text-decoration: underline; text-decoration-thickness: 1px; }
  .c-addr { font-style: normal; font-size: 1.35rem; line-height: 1.3; display: grid; }
  .c-list li { padding: 0.2rem 0; }
  .c-art { height: clamp(10rem, 22vw, 18rem); margin-top: clamp(3rem, 6vw, 5rem); }
  .c-art :global(svg) { width: 100%; height: 100%; }
  @media (max-width: 860px) { .c-grid { grid-template-columns: 1fr; } .c-block, .c-block:not(:nth-child(3n + 1)) { padding-left: 0; border-left: 0; } }
</style>
