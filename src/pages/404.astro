---
import Base from '../layouts/Base.astro';
import Pattern from '../components/Pattern.astro';
---
<Base title="Page not found" description="This page does not exist.">
  <section class="nf">
    <div class="nf-art" aria-hidden="true"><Pattern behaviour="signal" w={1400} h={500} lines={14} seed="404" accent="#3149b0" /></div>
    <div class="wrap nf-in">
      <p class="label kicker">404</p>
      <h1 class="hero-t">This line goes nowhere.</h1>
      <p class="lead">The page you were looking for isn’t here. Try one of the divisions, or start a brief.</p>
      <p class="nf-links"><a class="btn" href="/">Home</a><a class="btn btn-line" href="/aroma">Aroma</a><a class="btn btn-line" href="/hospitality">Hospitality</a><a class="btn btn-line" href="/technology">Technology</a></p>
    </div>
  </section>
</Base>
<style>
  .nf { position: relative; min-height: 70svh; display: grid; align-items: center; overflow: hidden; }
  .nf-art { position: absolute; inset: 45% 0 0; opacity: 0.8; }
  .nf-art :global(svg) { width: 100%; height: 100%; }
  .nf-in { position: relative; display: grid; gap: 1.25rem; padding-block: 4rem; }
  .nf-links { display: flex; flex-wrap: wrap; gap: 0.6rem; }
</style>
