---
import { safeJson } from '../lib/safe-json';
import Base from '../layouts/Base.astro';
import Pattern from '../components/Pattern.astro';
import ScentFinder from '../components/ScentFinder.astro';
import ProductCard from '../components/ProductCard.astro';
import { Image } from 'astro:assets';
import { fieldSVG } from '../lib/flowfield';
import { signatureSVG } from '../lib/signature';
import { scentBySlug } from '../lib/library';
import { divisions } from '../data/divisions';
import { company } from '../data/company';
import { scents, clientScents } from '../lib/library';
import { shopProducts } from '../lib/catalog';

import hotel from '../assets/concept/hotel-lobby.webp';
import reed from '../assets/concept/reed-diffuser.webp';
import oil from '../assets/concept/fragrance-oil.webp';
import amenities from '../assets/concept/guest-amenities.webp';
import restaurant from '../assets/concept/restaurant.webp';
import residential from '../assets/concept/residential.webp';
import hospital from '../assets/concept/hospital.webp';
import airport from '../assets/concept/airport.webp';
import mall from '../assets/concept/mall.webp';
import ops from '../assets/concept/operations-room.webp';
import dc from '../assets/concept/data-centre.webp';

const accent = { aroma: 'var(--aroma)', hospitality: 'var(--hospitality)', technology: 'var(--technology)' } as const;
const hex = { aroma: '#b4612a', hospitality: '#3e5c50', technology: '#3149b0' } as const;

// What each division can bring to each space the company lists. These are
// category matches, not claims of past projects.
const spaces = [
  { name: 'Hotels', img: hotel, alt: 'A sunlit hotel lobby with a sculptural chandelier', brings: ['Signature lobby scent', 'Guest room linen & amenities', 'Digital signage'], d: ['aroma', 'hospitality', 'technology'] },
  { name: 'Restaurants', img: restaurant, alt: 'An evening restaurant dining room with round tables', brings: ['Ambient scent', 'F&B linen', 'Banquet furniture'], d: ['aroma', 'hospitality'] },
  { name: 'Residential buildings', img: residential, alt: 'Residential towers at dusk with a landscaped entrance', brings: ['Lobby & corridor scent', 'Smart building systems'], d: ['aroma', 'technology'] },
  { name: 'Malls', img: mall, alt: 'A bright mall atrium with a glass roof', brings: ['Scent across large areas', 'Digital signage'], d: ['aroma', 'technology'] },
  { name: 'Airports', img: airport, alt: 'An airport terminal with a long glazed facade', brings: ['Lounge scent', 'Signage & connectivity'], d: ['aroma', 'technology'] },
  { name: 'Hospitals', img: hospital, alt: 'A calm hospital reception area', brings: ['Calming reception scent', 'Linen & trolleys'], d: ['aroma', 'hospitality'] },
  { name: 'Information technology', img: ops, alt: 'An operations room with a wall of screens', brings: ['ICT & connectivity', 'System integration'], d: ['technology'] },
  { name: 'AI and data centres', img: dc, alt: 'Rows of server racks in a data centre', brings: ['Infrastructure & connectivity', 'Support & maintenance'], d: ['technology'] },
] as const;
const heroScent = scentBySlug['royal-residence'];
const heroSvg = signatureSVG(heroScent, { size: 640, mode: 'ink', ink: '#f2eee7', hairline: 1.3 });
const divPhoto = { aroma: { img: oil, alt: 'Amber fragrance oil drawn from a glass bottle with a dropper' }, hospitality: { img: amenities, alt: 'Folded towels and amber amenity bottles on a stone vanity' }, technology: { img: dc, alt: 'Rows of server racks with status lights' } } as const;
const featured = [5390, 5516, 5258, 5243].map((id) => shopProducts.find((p) => p.id === id)).filter((p): p is NonNullable<typeof p> => !!p);
const productCount = shopProducts.length;
---
<Base title="Global Aroma — Scent, hospitality and technology for commercial spaces" description="Global DWC LLC brings scent marketing, hospitality supplies and business technology together from Dubai World Central. Shop oils and diffusers online, find a fragrance by feel, or build a brief." current="home" og="home">
  <section class="hero dark" aria-labelledby="hero-h">
    <div class="hero-img">
      <Image src={reed} alt="A reed diffuser on a stone ledge in warm evening light" widths={[800, 1400, 2042]} sizes="100vw" loading="eager" fetchpriority="high" />
    </div>
    <div class="hero-sig" aria-hidden="true"><div class="reveal" set:html={heroSvg} /></div>
    <div class="wrap hero-in">
      <p class="label kicker reveal">Global DWC LLC · Dubai World Central</p>
      <h1 class="mega reveal" id="hero-h">How a space feels.</h1>
      <p class="lead reveal">Fragrance, hospitality supplies and business technology for hotels, malls, offices and homes. Three divisions, one team in Dubai.</p>
      <div class="hero-cta reveal">
        <a class="btn" href="/shop">Shop oils &amp; diffusers</a>
        <a class="btn btn-line" href="/brief">Start a brief</a>
      </div>
    </div>
    <p class="hero-cap wrap"><span class="label">Concept image</span> The lines are the signature of <a href={`/aroma#scent-${heroScent.slug}`}>{heroScent.title}</a>, drawn from its notes.</p>
  </section>

  <section class="section divs-sec" aria-labelledby="div-h">
    <div class="wrap">
      <div class="section-head">
        <h2 class="h1 sh-t reveal" id="div-h">Three divisions, one team.</h2>
        <p class="body-copy sh-d reveal">A hotel can scent its lobby, dress its rooms and connect its screens with a single point of contact.</p>
      </div>
      <ul class="dcards">
        {divisions.map((d, i) => (
          <li class="dcard reveal" style={`--c:${accent[d.id]};--ct:var(--${d.id}-text)`}>
            <a href={d.href} class="dcard-link">
              <span class="figure dcard-img"><Image src={divPhoto[d.id].img} alt={divPhoto[d.id].alt} widths={[480, 800]} sizes="(max-width: 860px) 100vw, 33vw" loading="lazy" /><span class="tag">Concept image</span></span>
              <span class="dcard-line" aria-hidden="true"><Pattern behaviour={d.behaviour} w={600} h={56} lines={d.behaviour === 'weave' ? 3 : 5} seed={d.id + 'card'} accent={hex[d.id]} /></span>
              <span class="label label-muted">0{i + 1} · {d.kicker}</span>
              <span class="dcard-name serif">{d.name}</span>
              <span class="dcard-stmt serif">{d.statement}</span>
              <span class="dcard-cats">{d.categories.slice(0, 3).map((c) => c.name).join(' · ')}</span>
              <span class="link dcard-more">Explore {d.short} <span aria-hidden="true">→</span></span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="section dark finder-sec" aria-labelledby="find-h">
    <div class="wrap finder-in">
      <div class="finder-intro">
        <p class="label label-muted kicker reveal">The scent collection</p>
        <h2 class="h1 reveal" id="find-h">Find a scent for your space.</h2>
        <p class="muted reveal">Tell us how it should feel and we’ll show the closest of the {scents.length} fragrances in the collection, matched by their notes.</p>
        <p class="finder-links"><a class="link" href="/aroma#map">Explore the scent map</a><a class="link" href="/aroma#library">Browse all {scents.length}</a></p>
      </div>
      <ScentFinder id="home-finder" libraryHref="/aroma" dark />
    </div>
  </section>

  <section class="section tint" aria-labelledby="shop-h">
    <div class="wrap">
      <div class="section-head">
        <div class="sh-t">
          <p class="label label-muted kicker reveal">Shop</p>
          <h2 class="h1 reveal" id="shop-h">Order online.</h2>
        </div>
        <div class="sh-d reveal">
          <p class="body-copy">Diffuser oils and diffusers with prices from the official store. Choose here, then check out on globalaroma.me.</p>
          <p class="shop-ctas"><a class="btn" href="/shop">Browse all {productCount} products</a><a class="link" href="/brief">Volumes or projects? Ask us</a></p>
        </div>
      </div>
      <ul class="feat">{featured.map((p) => <ProductCard p={p} detailsHref="/shop" />)}</ul>
    </div>
  </section>
  <section class="section" aria-labelledby="spaces-h">
    <div class="wrap">
      <div class="section-head">
        <h2 class="h1 sh-t reveal" id="spaces-h">Spaces we work in.</h2>
        <p class="body-copy sh-d reveal">The industries Global DWC serves, and what each division brings to them.</p>
      </div>
    </div>
    <div class="rail" tabindex="0" aria-label="Spaces, scroll horizontally">
      <ul class="rail-in">
        {spaces.map((s) => (
          <li class="space">
            <div class="figure space-img">
              <Image src={s.img} alt={s.alt} widths={[420, 640, 900]} sizes="(max-width: 640px) 82vw, 30rem" loading="lazy" />
              <span class="tag">Concept image</span>
            </div>
            <div class="space-body">
              <h3 class="h3">{s.name}</h3>
              <ul class="space-brings">{s.brings.map((b) => <li>{b}</li>)}</ul>
              <p class="space-d" aria-label="Divisions">{s.d.map((d) => <span class="dot" style={`background:${accent[d]}`} title={d} />)}</p>
            </div>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="cta dark">
    <div class="cta-field" aria-hidden="true" set:html={fieldSVG(1600, 500, 22)} />
    <div class="wrap cta-in">
      <h2 class="mega cta-h">Let’s talk<br />about your space.</h2>
      <div class="cta-side">
        <a class="btn" href="/brief">Start a brief</a>
        <a class="btn btn-line" href={`https://wa.me/${company.whatsapp.number}?text=${encodeURIComponent('Hello Global Aroma, I would like to discuss a space.')}`} rel="noopener">WhatsApp {company.whatsapp.display}</a>
        <p class="muted">Or call <a href={company.phone.href}>{company.phone.display}</a></p>
      </div>
    </div>
  </section>

  <script type="application/json" id="scent-data" set:html={safeJson(clientScents())} />
</Base>

<script>
  import '../scripts/scents-ui';
</script>

<style>
  .hero { position: relative; min-height: min(100svh, 56rem); display: grid; align-content: end; overflow: hidden; padding-block: 6rem 2rem; }
  .hero-img { position: absolute; inset: 0; }
  .hero-img :global(img) { width: 100%; height: 100%; object-fit: cover; object-position: 72% 50%; }
  .hero-img::after { content: ''; position: absolute; inset: 0; background: linear-gradient(90deg, rgba(20,16,12,0.86) 0%, rgba(20,16,12,0.62) 38%, rgba(20,16,12,0.08) 70%), linear-gradient(0deg, rgba(20,16,12,0.55), transparent 40%); }
  .hero-sig { position: absolute; right: 6%; top: 8%; width: min(46vw, 40rem); opacity: 0.9; pointer-events: none; }
  .hero-sig :global(svg) { width: 100%; height: auto; }
  @media (prefers-reduced-motion: no-preference) {
    .hero-sig :global(path) { stroke-dasharray: 1; stroke-dashoffset: 1; transition: stroke-dashoffset 3.2s var(--ease); }
    .hero-sig :global(.in path) { stroke-dashoffset: 0; }
    .hero-sig :global(path:nth-child(2n)) { transition-delay: 0.3s; } .hero-sig :global(path:nth-child(3n)) { transition-delay: 0.6s; }
  }
  .hero-in { position: relative; display: grid; gap: 1.5rem; justify-items: start; max-width: var(--maxw); }
  .hero-in h1 { max-width: 9ch; text-shadow: 0 2px 40px rgba(0,0,0,0.25); }
  .hero-in .lead { max-width: 34ch; color: #e8e1d6; }
  .hero-cta { display: flex; flex-wrap: wrap; gap: 0.75rem; }
  .hero-cap { position: relative; margin-top: clamp(2rem, 6vh, 4rem); font-size: 0.8rem; color: var(--p-72); text-align: right; }
  .hero-cap .label { margin-right: 0.6rem; }
  .hero-cap a { color: var(--paper); }
  @media (max-width: 860px) {
    .hero { min-height: 0; padding: 0; display: block; }
    .hero-img { position: relative; height: 52svh; min-height: 20rem; }
    .hero-img :global(img) { object-position: 78% 50%; }
    .hero-img::after { background: linear-gradient(0deg, var(--ink) 0%, rgba(26,23,20,0.2) 45%, transparent 70%); }
    .hero-sig { right: -6%; top: 2%; width: 78vw; }
    .hero-in { margin-top: -4.5rem; padding-bottom: 1.5rem; gap: 1.1rem; }
    .hero-in h1 { max-width: none; }
    .hero-cap { text-align: left; margin-top: 0; padding-bottom: 1.5rem; }
  }

  .dcards { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: clamp(1rem, 2vw, 2rem); }
  .dcard-link { display: grid; gap: 0.55rem; text-decoration: none; align-content: start; }
  .dcard-img { aspect-ratio: 4 / 3; }
  .dcard-img :global(img) { transition: transform 1.2s var(--ease); }
  .dcard-link:hover .dcard-img :global(img) { transform: scale(1.04); }
  .dcard-line { display: block; height: 56px; border-bottom: 3px solid var(--c); overflow: hidden; margin-bottom: 0.4rem; }
  .dcard-line :global(.pattern) { height: 100%; }
  .dcard-name { font-size: clamp(1.6rem, 2.4vw, 2.1rem); letter-spacing: -0.02em; line-height: 1.05; }
  .dcard-stmt { color: var(--ct); font-size: 1.15rem; line-height: 1.25; }
  .dcard-cats { font-size: 0.88rem; color: var(--ink-72); }
  .dcard-more { justify-self: start; margin-top: 0.3rem; }
  @media (max-width: 860px) {
    .dcards { grid-template-columns: 1fr; gap: 0; border-top: var(--line); }
    .dcard-link { grid-template-columns: 7rem 1fr; column-gap: 1rem; row-gap: 0.25rem; padding-block: 1.1rem; border-bottom: 3px solid var(--c); }
    .dcard-img { grid-row: 1 / span 5; aspect-ratio: 1; align-self: start; }
    .dcard-img .tag { font-size: 0.55rem; padding: 0.15rem 0.3rem; left: 0.3rem; bottom: 0.3rem; }
    .dcard-line { display: none; }
    .dcard-name { font-size: 1.5rem; }
    .dcard-stmt { font-size: 1rem; }
    .dcard-cats { font-size: 0.8rem; }
  }

  .finder-in { display: grid; grid-template-columns: minmax(0, 5fr) minmax(0, 7fr); gap: clamp(2rem, 5vw, 5rem); align-items: start; }
  .finder-intro { display: grid; gap: 1.1rem; position: sticky; top: calc(var(--nav-h) + 2rem); }
  .finder-links { display: flex; flex-wrap: wrap; gap: 0.75rem 1.5rem; }
  @media (max-width: 960px) { .finder-in { grid-template-columns: 1fr; } .finder-intro { position: static; } }

  .shop-ctas { display: flex; flex-wrap: wrap; gap: 0.75rem 1.5rem; align-items: center; margin-top: 1.25rem; }
  .feat { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); border-top: var(--line); border-left: var(--line); }
  @media (max-width: 960px) { .feat { grid-template-columns: 1fr 1fr; } }

  .rail { overflow-x: auto; scroll-snap-type: x mandatory; scrollbar-width: thin; padding-inline: max(var(--gutter), calc((100vw - var(--maxw)) / 2 + var(--gutter))); scroll-padding-inline: max(var(--gutter), calc((100vw - var(--maxw)) / 2 + var(--gutter))); }
  .rail:focus-visible { outline-offset: -3px; }
  .rail-in { display: grid; grid-auto-flow: column; grid-auto-columns: clamp(16rem, 28vw, 25rem); gap: clamp(1rem, 2vw, 1.75rem); padding-bottom: 1rem; }
  .space { scroll-snap-align: start; display: grid; gap: 1rem; align-content: start; }
  .space-img { aspect-ratio: 4 / 5; }
  .space-body { display: grid; gap: 0.6rem; }
  .space-brings li { font-size: 0.92rem; color: var(--ink-72); padding: 0.35rem 0; border-bottom: var(--line); }
  .space-d { display: flex; gap: 0.35rem; }
  @media (max-width: 640px) { .rail-in { grid-auto-columns: 78vw; } }

  .cta { padding-block: clamp(5rem, 11vw, 10rem); }
  .cta-in { display: grid; grid-template-columns: 1fr auto; align-items: end; gap: 2.5rem; }
  .cta-side { display: grid; gap: 0.75rem; justify-items: start; }
  .cta-side .btn { width: 100%; }
  @media (max-width: 860px) { .cta-in { grid-template-columns: 1fr; } }
  .cta { position: relative; overflow: hidden; }
  .cta-field { position: absolute; inset: 40% 0 0; opacity: 0.35; pointer-events: none; }
  .cta-field :global(svg) { width: 100%; height: 100%; }
  .cta-field :global(path[stroke="#1a1714"]) { stroke: #f2eee7; }
  .cta-in { position: relative; }
</style>
