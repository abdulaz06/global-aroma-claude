---
import '../styles/global.css';
import Mark from '../components/Mark.astro';
import { company } from '../data/company';
import serifFont from '@fontsource-variable/newsreader/files/newsreader-latin-opsz-normal.woff2?url';
import sansFont from '@fontsource-variable/schibsted-grotesk/files/schibsted-grotesk-latin-wght-normal.woff2?url';

interface Props {
  title: string;
  description: string;
  og?: string;
  /** Section of the site, for the nav. */
  current?: 'home' | 'aroma' | 'hospitality' | 'technology' | 'shop' | 'brief' | 'contact' | 'none';
  /** Page accent (division colour). */
  accent?: string;
  minimal?: boolean;
  /** The owner review guide itself (changes the review bar's link). */
  review?: boolean;
}
const { title, description, og = 'default', current = 'none', accent, minimal = false, review = false } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL(`/og/${og}.png`, Astro.site);
const fullTitle = current === 'home' ? title : `${title} — Global Aroma`;
const nav = [
  { id: 'aroma', href: '/aroma', label: 'Aroma', color: 'var(--aroma)' },
  { id: 'hospitality', href: '/hospitality', label: 'Hospitality', color: 'var(--hospitality)' },
  { id: 'technology', href: '/technology', label: 'Technology', color: 'var(--technology)' },
  { id: 'shop', href: '/shop', label: 'Shop' },
  { id: 'contact', href: '/contact', label: 'Contact' },
];
---
<!doctype html>
<html lang="en-AE">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
  <title>{fullTitle}</title>
  <meta name="description" content={description} />
  <!-- Unofficial concept pending owner approval: keep out of search indexes. -->
  <meta name="robots" content="noindex, nofollow, noarchive" />
  <link rel="canonical" href={canonical} />
  <meta name="theme-color" content="#f2eee7" />
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <link rel="preload" href={serifFont} as="font" type="font/woff2" crossorigin />
  <link rel="preload" href={sansFont} as="font" type="font/woff2" crossorigin />
  <meta property="og:type" content="website" />
  <meta property="og:site_name" content="Global Aroma (concept)" />
  <meta property="og:title" content={fullTitle} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonical} />
  <meta property="og:image" content={ogImage} />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta property="og:image:alt" content="Global Aroma: contour lines drawn from a fragrance's notes, with the group's three divisions." />
  <meta name="twitter:card" content="summary_large_image" />
  <script is:inline>document.documentElement.classList.add('js');</script>
  <slot name="head" />
</head>
<body style={accent ? `--accent:${accent}` : undefined}>
  <a class="skip" href="#main">Skip to content</a>
  <!-- Owner review only: remove at launch. -->
  <div class="review-bar" role="note">
    <div class="wrap review-in">
      <span><b>Proposal preview</b><span class="review-sub"> · an unofficial working concept for Global Aroma</span></span>
      {review ? <a href="/">Go to the website →</a> : <a href="/review/">Owner review guide →</a>}
    </div>
  </div>
  <header class="nav" data-nav>
    <div class="wrap nav-in">
      <a class="brand" href="/">
        <Mark />
        <span><span class="brand-name">Global Aroma</span><span class="brand-sub">GLOBAL DWC LLC · DUBAI</span></span>
      </a>
      {!minimal && (
        <nav class="nav-links" aria-label="Main">
          {nav.map((n) => (
            <a href={n.href} aria-current={current === n.id ? 'page' : undefined}>
              {n.color && <span class="nd" style={`background:${n.color}`} aria-hidden="true" />}{n.label}
            </a>
          ))}
        </nav>
      )}
      <div class="nav-actions">
        <a class="btn btn-sm brief-pill" href="/brief" aria-current={current === 'brief' ? 'page' : undefined}>
          Brief <span class="brief-count" data-brief-count aria-label="items in your brief">0</span>
        </a>
        <button class="btn btn-sm btn-line menu-btn" type="button" aria-expanded="false" aria-controls="mobile-menu" data-menu>Menu</button>
      </div>
    </div>
  </header>
  <div class="mobile-menu" id="mobile-menu" hidden>
    {nav.map((n, i) => (
      <a class="mm" href={n.href}><span>{n.label}</span><span class="label label-muted">0{i + 1}</span></a>
    ))}
    <a class="mm" href="/brief"><span>Your brief</span><span class="label label-muted" data-brief-count-text>0 items</span></a>
    <div class="mm-foot">
      <a class="btn" href="/shop">Shop oils &amp; diffusers</a>
      <a class="btn btn-line" href={company.phone.href}>Call {company.phone.display}</a>
    </div>
  </div>

  <main id="main"><slot /></main>

  <footer class="footer dark">
    <div class="wrap">
      <div class="footer-grid">
        <div>
          <a class="brand" href="/"><Mark color="#f2eee7" /><span><span class="brand-name">Global Aroma</span><span class="brand-sub" style="color:var(--p-56)">GLOBAL DWC LLC · DUBAI</span></span></a>
          <p class="muted" style="margin-top:1.5rem;max-width:34ch">Scent marketing, hospitality supplies and business technology. Three divisions of Global DWC LLC, based in Dubai World Central.</p>
        </div>
        <div>
          <h2>Divisions</h2>
          <ul>
            <li><a href="/aroma">Global Aroma</a></li>
            <li><a href="/hospitality">Global Hospitality</a></li>
            <li><a href="/technology">Global Technology</a></li>
          </ul>
        </div>
        <div>
          <h2>Order &amp; enquire</h2>
          <ul>
            <li><a href="/shop">Shop oils &amp; diffusers</a></li>
            <li><a href={company.store.shop} rel="noopener">Global Aroma store ↗</a></li>
            <li><a href="/aroma#library">Scent collection</a></li>
            <li><a href="/brief">Build a brief</a></li>
            <li><a href="/contact">Contact</a></li>
          </ul>
        </div>
        <div>
          <h2>Dubai office</h2>
          <ul>
            {company.address.lines.map((l) => <li style="color:var(--p-72)">{l}</li>)}
            <li><a href={company.phone.href}>{company.phone.display}</a></li>
            <li><a href={`mailto:${company.email.general}`}>{company.email.general}</a></li>
          </ul>
        </div>
      </div>
      <div class="footer-base">
        <p class="concept-note">Unofficial design concept for Global DWC LLC, pending owner approval. Not the official website. Photographs marked “Concept” are illustrative, not the company’s own installations. <a href="/review/">Owner review guide</a></p>
        <p>© {new Date().getFullYear()} Global DWC LLC</p>
      </div>
    </div>
  </footer>

  <div class="toast" role="status" aria-live="polite" data-toast><span data-toast-text></span><a href="/brief">View brief</a></div>
  <script>
    import '../scripts/site';
  </script>
</body>
</html>
